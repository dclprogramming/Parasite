<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar entry: rounded pill. Accent when focused, soft white when it is the current page. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/header_focus_bg"/>
                <corners android:radius="12dp"/>
            </shape>
        </inset>
    </item>
    <item android:state_selected="true">
        <inset android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/header_selected_bg"/>
                <corners android:radius="12dp"/>
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</selector>
